<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cuiyi.passwordnotebook">

    <!--
        Declared explicitly because the build script also passes  - target-sdk-version:
        two sources for the same value invite drift, and Play rejects a mismatch.
        Target 36 (Android 16) so the app is accepted on current devices; minSdk 24
        keeps Android 7.0 working.
    -->
    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!--
        Biometric prompt for the fingerprint unlock. USE_FINGERPRINT is listed
        alongside USE_BIOMETRIC only for devices older than API 28; it is a no-op
        on modern versions.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!--
        No storage permissions are declared on purpose. Backups are read through
        the Storage Access Framework, which grants access to the single file the
        user picks and to nothing else, so the app never needs broad filesystem
        access. Requesting WRITE_EXTERNAL_STORAGE here would hand the app far more
        reach than it uses and show the user a scary permission prompt.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
